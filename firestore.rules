rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // GLOBAL DEFAULT-DENY — every collection is locked by default
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================
    // REUSABLE HELPER FUNCTIONS
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "admin@paktajarat.pk" ||
        request.auth.token.email == "akdevstudiosolutions@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Admin")
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdminOrWorker() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Worker"
      );
    }

    // ============================================================
    // TEST CONNECTION (connection probe only — no real data)
    // ============================================================
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================================
    // USERS COLLECTION
    // ============================================================
    match /users/{userId} {
      // Anyone (including anonymous) can read their own profile
      allow read: if isOwner(userId) || isAdmin();
      // Create: signed-in user creating their own doc
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['id','email','fullName','role']) &&
        request.resource.data.role in ['User','Admin','Worker'] &&
        request.resource.data.email is string &&
        request.resource.data.fullName is string;
      // Update: own profile only (cannot self-promote to Admin)
      allow update: if isOwner(userId) &&
        (request.resource.data.role == resource.data.role || isAdmin());
      // Delete: admin only
      allow delete: if isAdmin();
    }

    // ============================================================
    // WORKER ACCOUNTS
    // ============================================================
    match /worker_accounts/{workerId} {
      // Workers & admin can list (needed for login validation)
      allow read: if isSignedIn() || request.auth == null;
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // PRODUCTS COLLECTION
    // ============================================================
    match /products/{productId} {
      // Public read — anyone can browse products
      allow read: if true;
      // Only admin or worker (products module) can write
      allow create, update, delete: if isAdminOrWorker();
    }

    // ============================================================
    // ORDERS COLLECTION
    // ============================================================
    match /orders/{orderId} {
      // User can read their own orders; admin sees all
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      // Anyone (including guest checkout) can place an order
      allow create: if
        request.resource.data.keys().hasAll(['id','userId','items','total','status','paymentMethod','shippingAddress','date']) &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.status == 'Pending';
      // Only admin/worker can update status
      allow update: if isAdminOrWorker();
      allow delete: if isAdmin();
    }

    // ============================================================
    // REVIEWS COLLECTION
    // ============================================================
    match /reviews/{reviewId} {
      allow read: if true;
      // Signed-in user can submit review
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['id','productId','userName','userEmail','rating','comment','date']) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // AFFILIATES COLLECTION
    // ============================================================
    match /affiliates/{affiliateId} {
      allow read: if isOwner(affiliateId) || isAdmin();
      allow create: if isSignedIn() && isOwner(affiliateId);
      allow update: if isOwner(affiliateId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // AFFILIATE APPLICATIONS
    // ============================================================
    match /affiliateApplications/{applicationId} {
      allow read: if isOwner(applicationId) || isAdmin();
      allow create: if isSignedIn() && isOwner(applicationId) &&
        request.resource.data.uid is string &&
        request.resource.data.fullName is string &&
        request.resource.data.email is string &&
        request.resource.data.acceptedTerms == true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // REFERRALS COLLECTION
    // ============================================================
    match /referrals/{referralId} {
      allow read: if isSignedIn() &&
        (resource.data.affiliateId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['id','affiliateId','status','date','type']);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.affiliateId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ============================================================
    // WITHDRAWALS COLLECTION
    // ============================================================
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() &&
        (resource.data.affiliateId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['id','affiliateId','amount','paymentMethod','paymentDetails','status','date']) &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // COUPONS COLLECTION
    // ============================================================
    match /coupons/{couponId} {
      // Public read so checkout can validate
      allow read: if true;
      allow create, update, delete: if isAdminOrWorker();
    }

    // ============================================================
    // SYSTEM CONFIG (branding, SEO, settings)
    // ============================================================
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // BLOGS COLLECTION
    // ============================================================
    match /blogs/{blogId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrWorker();
    }

    // ============================================================
    // MEDIA LIBRARY
    // ============================================================
    match /mediaLibrary/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrWorker();
    }

    // ============================================================
    // TRAFFIC / ANALYTICS (write-only from client, admin reads)
    // ============================================================
    match /trafficSessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /liveVisitors/{visitorId} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /liveEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }

    // ============================================================
    // ENTERPRISE AFFILIATE SUB-COLLECTIONS (admin-managed)
    // ============================================================
    match /affiliateLinks/{linkId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /affiliatePayments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.affiliateId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /affiliateCoupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /affiliateAssets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /affiliateNotifications/{notifId} {
      allow read: if isSignedIn() && resource.data.affiliateId == request.auth.uid;
      allow write: if isAdmin();
    }
    match /affiliateReports/{reportId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /affiliateSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /affiliateLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /affiliateFraud/{fraudId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /affiliateStatistics/{affiliateId} {
      allow read: if isAdmin() || (isSignedIn() && affiliateId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /affiliateCommissions/{commissionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.affiliateId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /affiliateOrders/{orderId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /affiliateWithdrawals/{withdrawalId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.affiliateId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /affiliateClicks/{clickId} {
      allow read: if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }
    match /affiliateProducts/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
