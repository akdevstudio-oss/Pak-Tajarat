{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with roles and saved shipping addresses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["User", "Admin"] },
        "phone": { "type": "string" },
        "addresses": {
          "type": "array",
          "description": "Saved shipping addresses of the user"
        }
      },
      "required": ["id", "email", "fullName", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Product in the e-commerce inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "image": { "type": "string" },
        "images": { "type": "array" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "stock": { "type": "number" },
        "specifications": { "type": "object" },
        "isFeatured": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isFlashSale": { "type": "boolean" }
      },
      "required": ["id", "name", "price", "image", "category", "stock", "specifications"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order purchase record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Processing", "Shipped", "Delivered", "Cancelled"] },
        "paymentMethod": { "type": "string", "enum": ["Cash on Delivery", "Debit/Credit Card"] },
        "shippingAddress": { "type": "object" },
        "billingAddress": { "type": "object" },
        "date": { "type": "string" },
        "affiliateId": { "type": "string", "description": "ID of referring affiliate if applicable" },
        "referralCommissionEarned": { "type": "number" }
      },
      "required": ["id", "userId", "items", "subtotal", "shipping", "discount", "total", "status", "paymentMethod", "shippingAddress", "date"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback on a product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "productId", "userName", "userEmail", "rating", "comment", "date"]
    },
    "Affiliate": {
      "title": "Affiliate Account",
      "description": "Affiliate marketer statistics and referral code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "referralCode": { "type": "string" },
        "totalClicks": { "type": "number" },
        "totalReferrals": { "type": "number" },
        "totalEarnings": { "type": "number" },
        "pendingCommission": { "type": "number" },
        "paidCommission": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive", "pending_approval"] },
        "paymentMethod": { "type": "string" },
        "paymentDetails": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "referralCode", "totalClicks", "totalReferrals", "totalEarnings", "pendingCommission", "paidCommission", "status"]
    },
    "Referral": {
      "title": "Referral Transaction",
      "description": "Individual click or referral order conversion",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "affiliateId": { "type": "string" },
        "referredUserId": { "type": "string" },
        "orderId": { "type": "string" },
        "purchaseAmount": { "type": "number" },
        "commissionAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "paid"] },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["click", "conversion"] }
      },
      "required": ["id", "affiliateId", "status", "date", "type"]
    },
    "Withdrawal": {
      "title": "Withdrawal Request",
      "description": "Payout request submitted by an affiliate",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "affiliateId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentDetails": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "date": { "type": "string" }
      },
      "required": ["id", "affiliateId", "amount", "paymentMethod", "paymentDetails", "status", "date"]
    },
    "Config": {
      "title": "System Configuration",
      "description": "Global system configurations like commission percentage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "commissionPercentage": { "type": "number" }
      },
      "required": ["id", "commissionPercentage"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupons and affiliate rewards",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "discountValue": { "type": "number" },
        "minSpend": { "type": "number" },
        "isReward": { "type": "boolean" },
        "assignedTo": { "type": "string" },
        "eligibility": { "type": "string" }
      },
      "required": ["code", "discountType", "discountValue"]
    },
    "TrafficSession": {
      "title": "Traffic Session",
      "description": "User traffic log or pageview event recorded for real-time BI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "uid": { "type": "string" },
        "timestamp": { "type": "string" },
        "deviceType": { "type": "string", "enum": ["mobile", "desktop", "tablet"] },
        "browser": { "type": "string" },
        "os": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "language": { "type": "string" },
        "referrer": { "type": "string" },
        "sessionId": { "type": "string" }
      },
      "required": ["id", "path", "timestamp", "deviceType", "sessionId"]
    },
    "AffiliateApplication": {
      "title": "Affiliate Application",
      "description": "Application details submitted to join the affiliate program",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "country": { "type": "string" },
        "previousAffiliateExperience": { "type": "boolean" },
        "previousAffiliatePrograms": { "type": "string" },
        "promotionMethods": { "type": "array" },
        "otherPromotionMethod": { "type": "string" },
        "reasonForJoining": { "type": "string" },
        "estimatedMonthlySales": { "type": "string" },
        "socialMedia": { "type": "object" },
        "acceptedTerms": { "type": "boolean" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "affiliateActivated": { "type": "boolean" },
        "emailVerified": { "type": "boolean" },
        "adminNotes": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["uid", "fullName", "email", "mobileNumber", "country", "promotionMethods", "reasonForJoining", "estimatedMonthlySales", "acceptedTerms", "status"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "Educational or promotional content for SEO optimization and customer engagement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "coverImage": { "type": "string" },
        "category": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string" },
        "readTime": { "type": "string" },
        "tags": { "type": "array" },
        "metaTitle": { "type": "string" },
        "metaDescription": { "type": "string" },
        "metaKeywords": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "language": { "type": "string", "enum": ["en", "ur", "both"] }
      },
      "required": ["id", "title", "slug", "excerpt", "content", "coverImage", "category", "author", "date", "readTime", "tags", "metaTitle", "metaDescription", "metaKeywords", "isPublished", "language"]
    },
    "MediaItem": {
      "title": "Media Item",
      "description": "Uploaded image or asset asset stored in the media library",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "size": { "type": "number" },
        "type": { "type": "string" },
        "folder": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "altText": { "type": "string" },
        "tags": { "type": "array" }
      },
      "required": ["id", "name", "url", "size", "type", "folder", "uploadedAt"]
    },
    "LiveVisitor": {
      "title": "Live Visitor",
      "description": "Active real-time visitor session on the store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "currentView": { "type": "string" },
        "deviceType": { "type": "string" },
        "browser": { "type": "string" },
        "city": { "type": "string" },
        "referrer": { "type": "string" },
        "lastActive": { "type": "string" },
        "userRole": { "type": "string" },
        "userName": { "type": "string" }
      },
      "required": ["id", "sessionId", "currentView", "lastActive"]
    },
    "LiveEvent": {
      "title": "Live Click Event",
      "description": "Real-time user click and navigation interaction log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "eventType": { "type": "string" },
        "target": { "type": "string" },
        "view": { "type": "string" },
        "timestamp": { "type": "string" },
        "deviceType": { "type": "string" },
        "city": { "type": "string" },
        "userName": { "type": "string" }
      },
      "required": ["id", "eventType", "target", "timestamp"]
    }
  },
  "firestore": {
    "liveVisitors/{visitorId}": {
      "schema": "LiveVisitor",
      "description": "Real-time active website visitors currently browsing the store"
    },
    "liveEvents/{eventId}": {
      "schema": "LiveEvent",
      "description": "Real-time click stream of customer interactions across the website"
    },
    "mediaLibrary/{mediaId}": {
      "schema": "MediaItem",
      "description": "Store uploaded images and assets for website branding and CMS"
    },
    "blogs/{blogId}": {
      "schema": "BlogPost",
      "description": "High ranking optimization articles for SEO indexing"
    },
    "affiliateApplications/{applicationId}": {
      "schema": "AffiliateApplication",
      "description": "Detailed affiliate program applications"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User profile details"
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "E-commerce product items"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer order invoices"
    },
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product quality reviews"
    },
    "affiliates/{affiliateId}": {
      "schema": "Affiliate",
      "description": "Affiliate account tracking"
    },
    "referrals/{referralId}": {
      "schema": "Referral",
      "description": "Referral click and sale details"
    },
    "withdrawals/{withdrawalId}": {
      "schema": "Withdrawal",
      "description": "Affiliate payout requests"
    },
    "config/{configId}": {
      "schema": "Config",
      "description": "Global system settings"
    },
    "coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Discount coupons and affiliate rewards"
    },
    "affiliateProducts/{productId}": {
      "schema": "Product",
      "description": "Products configured for affiliate promotion"
    },
    "affiliateCommissions/{commissionId}": {
      "schema": "Referral",
      "description": "Detailed affiliate commission earnings records"
    },
    "affiliateOrders/{orderId}": {
      "schema": "Order",
      "description": "Orders referred by active affiliates"
    },
    "affiliateWithdrawals/{withdrawalId}": {
      "schema": "Withdrawal",
      "description": "Withdrawal history requested by partners"
    },
    "affiliateClicks/{clickId}": {
      "schema": "Referral",
      "description": "Individual click records on affiliate URLs"
    },
    "affiliateStatistics/{affiliateId}": {
      "schema": "Affiliate",
      "description": "Aggregated stats for verified affiliates"
    },
    "trafficSessions/{sessionId}": {
      "schema": "TrafficSession",
      "description": "User traffic logs for real-time BI analytics"
    },
    "affiliateLinks/{linkId}": {
      "description": "Generated affiliate referral and campaign links"
    },
    "affiliatePayments/{paymentId}": {
      "description": "Completed payout records and invoices for affiliates"
    },
    "affiliateCoupons/{couponId}": {
      "schema": "Coupon",
      "description": "Exclusive coupons assigned to affiliate partners"
    },
    "affiliateAssets/{assetId}": {
      "description": "Banners, graphics, and promotional copy templates"
    },
    "affiliateNotifications/{notifId}": {
      "description": "System and admin notifications sent to affiliate marketers"
    },
    "affiliateReports/{reportId}": {
      "description": "Generated performance, sales, and commission reports"
    },
    "affiliateSettings/{settingId}": {
      "description": "Enterprise global settings and commission rates"
    },
    "affiliateLogs/{logId}": {
      "description": "Audit trails and action history for affiliate operations"
    },
    "affiliateFraud/{fraudId}": {
      "description": "Flagged fraudulent clicks, orders, or suspicious IP logs"
    }
  }
}
